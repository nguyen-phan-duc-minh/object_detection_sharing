# Application Settings
APP_ENV=development
APP_NAME=Object Detection and Tracking

# Data Paths
DATA_SOURCE=inputs/videos
DATA_OUTPUT=outputs
DATA_MODEL=models

# Detector Configuration
DETECTOR_TYPE=yolo26n
DETECTOR_CONF_THRESHOLD=0.5
DETECTOR_IOU_THRESHOLD=0.7
DETECTOR_MAX_DET=100
DETECTOR_DEVICE=null
# DETECTOR_CLASSES=null for all classes, or comma-separated IDs like 0,2 (e.g., 0,2 for person and car)
DETECTOR_CLASSES=null

# Saver Configuration
SAVER_SAVE_IMAGES=false
SAVER_SAVE_DETECTIONS=false
SAVER_SAVE_CROPS=false

# Tracker Configuration
TRACKER_TYPE=bytetrack
